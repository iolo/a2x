1000 DG=24576: REM $6000
1010 FA=250: REM $FA; X1
1020 FB=251: REM $FB; Y1
1030 FC=252: REM $FC; X2
1040 FD=253: REM $FD; Y2
1050 FE=254: REM $FE; COLOR; CO
1060 FF=255: REM $FF; CH
1070 CE=206: REM $CE; SRC LO; SL
1080 CF=207: REM $CF; SRC HI; SH
1090 EB=235: REM $EB; DST LO; DL
1100 EC=236: REM $EC; DST HI; DH

2000 REM DGR_INIT
2010 CALL DG
2100 REM DGR_CLS
2110 FOR C = 0 TO 15
2120 POKE FE,C
2130 CALL DG+6
2140 NEXT C
2190 GET A$
2200 REM DGR_PLOT
2210 FOR I = 0 TO 50
2220 POKE FA,INT(RND(1)*80)
2230 POKE FB,INT(RND(1)*40)
2240 POKE FE,INT(RND(1)*16)
2250 CALL DG+9
2260 NEXT I
2290 GET A$
2300 REM DGR_HLINE
2310 C=0: FOR Y = 0 TO 39:
2320 C=C+1: IF C>15 THEN C=1
2330 POKE FA,0
2340 POKE FB,Y
2350 POKE FC,79
2360 POKE FE,C
2370 CALL DG+12
2380 NEXT Y
2390 GET A$
2400 REM DGR_VLINE
2410 C=0: FOR X = 0 TO 79
2420 C=C+1: IF C>15 THEN C=1
2430 POKE FA,X
2440 POKE FB,0
2450 POKE FD,39
2460 POKE FE,C
2470 CALL DG+15
2480 NEXT X
2490 GET A$
2500 REM DGR_RECT
2510 FOR I = 0 TO 18 STEP 2
2520 POKE FA,I
2530 POKE FB,I
2540 POKE FC,79-I
2550 POKE FD,40-I
2560 POKE FE,INT(RND(1)*16)
2570 CALL DG+18
2580 NEXT I
2590 GET A$
2600 REM DGR_FILLRECT
2610 FOR I = 0 TO 18 STEP 2
2620 POKE FA,I
2630 POKE FB,I
2640 POKE FC,79-I
2650 POKE FD,40-I
2660 POKE FE,INT(RND(1)*16)
2670 CALL DG+21
2680 NEXT I
2690 GET A$
2700 REM DGR_PIXMAP
2701 POKE FE,0: CALL DG+6: REM CLS
2710 X=0:Y=0:LO=PEEK(24612):HI=PEEK(24613):FOR I = 1 TO 10
2720 POKE FA,X: POKE FB,Y: POKE FC,X+7-1: POKE FD,Y+7-1: POKE FE,0
2730 POKE CE,LO: POKE CF,HI
2740 CALL DG+24
2750 X=X+10: IF X>70 THEN X=0: Y=Y+10: IF Y>30 THEN Y=0
2780 NEXT I
2790 GET A$
2800 REM DGR_BITMAP
2801 POKE FE,0: CALL DG+6: REM CLS
2810 X=0:Y=0:C=0:LO=PEEK(24614):HI=PEEK(24615):FOR I = 1 TO 10
2820 POKE FA,X: POKE FB,Y: POKE FC,X+8-1: POKE FD,Y+8-1: POKE FE,C
2830 POKE CE,LO: POKE CF,HI
2840 CALL DG+27
2850 X=X+10: IF X>70 THEN X=0: Y=Y+10: IF Y>30 THEN Y=0
2860 C=C+1: IF C>15 THEN C=1
2880 NEXT I
2890 GET A$
2900 REM DGR_PUTC
2901 POKE FE,0: CALL DG+6: REM CLS
2910 X=0:Y=0:C=0:FOR I = 32 TO 127
2920 POKE FA,X: POKE FB,Y: POKE FE,C
2930 POKE FF,I
2940 CALL DG+30
2950 X=X+4: IF X>70 THEN X=0: Y=Y+6: IF Y>30 THEN Y=0
2960 C=C+1: IF C>15 THEN C=1
2980 NEXT I
2990 GET A$
9900 REM DGR_EXIT
9910 TEXT: REM CALL DG+3
